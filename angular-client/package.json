{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:github": "ng build --base-href /PermutationGuess/",
    "build:netlify": "ng build --base-href /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:browser": "ng test --watch=false --browsers=ChromiumHeadless",
    "audit:dependencies": "npm audit --audit-level=low"
  },
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@vitest/browser-playwright": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
